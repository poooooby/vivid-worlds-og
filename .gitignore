# What git never tracks. The rules (and why) are in CLAUDE.md, "Ignore files".

# Build output: scripts/build-mod.py writes the release ZIP to dist/; assets/atlas/ is baked
# by tools/generate_sprite_atlases.py on every build and never hand-edited.
dist/
*.zip
/assets/atlas/

# Overworld art: a read-only copy from a sibling overworld-spawn-mod (Wilds of Kanto Revival)
# checkout (tools/copy_wilds_assets.py), plus the sheets baked from it
# (tools/generate_true_size_18frame.py) -- thousands of PNGs that GitHub never carries. Run
# both tools after cloning; the release ZIP ships the baked atlas instead.
/assets/enhanced_overworld/
/assets/wilds_generated/

# Local only: notes for Claude Code, the to-do list, Claude Code settings and skills
CLAUDE.md
TODO.md
/.claude/

# Developer-only switches and OS / tool clutter
wilds_dev.flag
.DS_Store
Thumbs.db
__pycache__/
